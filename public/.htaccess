DirectoryIndex index.html

# Canonical host: force non-www. Both hostnames resolve to this same docroot,
# and both returned HTTP 200 with no redirect, so every page existed at two
# crawlable URLs. The <link rel="canonical"> tags already pointed at the
# non-www version and Google had mostly consolidated on its own, but two live
# copies still split crawl budget on a low-authority domain. Make it a hard
# 301. This must stay ABOVE any other rewrite so it runs first.
# NOTE: this is a host redirect only — do NOT turn it into an SPA catch-all
# (see the ErrorDocument comment below for why that broke things before).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Campaign unsubscribe, proxied onto this domain.
  #
  # The marketing emails used to carry their unsubscribe link as a raw Supabase
  # function URL — https://hbkaxigmhgzjiommnfhj.supabase.co/functions/v1/...
  # A plain-text note from a local lawn guy containing a link to a random
  # cloud-infrastructure hostname reads as bulk mail: Gmail weighs whether a
  # message's link domains match its sender and its brand, and that one matched
  # nothing. Confirmed 2026-08-23 — the aeration campaign landed in Promotions.
  #
  # QSA preserves ?unsub=<email>, which is the only parameter the function reads.
  # 302 (not 301) on purpose: browsers cache 301s permanently, and if the
  # Supabase project ref ever changes a cached redirect would strand people on a
  # dead unsubscribe link — which is a legal problem, not just a broken one.
  # Keep this BELOW the www redirect so the canonical host is settled first.
  # Target is the standalone `unsubscribe` function, NOT send-campaign.
  # send-campaign runs verify_jwt=true (its POST sends to the whole list and has
  # to stay locked), and that flag applies to the whole function — so the GET
  # opt-out returned 401 to every recipient who clicked it. Split 2026-08-23.
  RewriteRule ^unsubscribe/?$ https://hbkaxigmhgzjiommnfhj.supabase.co/functions/v1/unsubscribe [R=302,L,QSA]
</IfModule>

# This is a fully static Next.js export with trailingSlash: true, so every real
# route exists on disk as a directory containing index.html. mod_dir resolves
# those (and 301-redirects the missing trailing slash), so NO SPA catch-all
# rewrite is needed. The old "RewriteRule ^ index.html [L]" served homepage
# content with HTTP 200 for every nonexistent URL, which made typo'd and stale
# links look to Google like duplicate copies of the homepage. Serve Next's real
# 404 page with a real 404 status instead.
ErrorDocument 404 /404.html

# Cache static assets for 1 year
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg       "access plus 1 year"
  ExpiresByType image/jpg        "access plus 1 year"
  ExpiresByType image/png        "access plus 1 year"
  ExpiresByType image/webp       "access plus 1 year"
  ExpiresByType image/gif        "access plus 1 year"
  ExpiresByType image/svg+xml    "access plus 1 year"
  ExpiresByType image/x-icon     "access plus 1 year"
  ExpiresByType video/mp4        "access plus 1 year"
  ExpiresByType font/woff2       "access plus 1 year"
  ExpiresByType font/woff        "access plus 1 year"
  ExpiresByType text/css         "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico|woff2|woff|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  # HTML was "no-cache, no-store, must-revalidate", which meant every request
  # for a fully static export went all the way to origin — measured ~440ms
  # upstream on the homepage, with nothing held at Hostinger's edge.
  #
  # 5 minutes fresh, then serve stale for a day while revalidating in the
  # background. Deploys are manual (Hostinger MCP), so the worst case is a
  # visitor seeing 5-minute-old HTML right after a push — and the images, CSS
  # and JS a stale page references are content-hashed by Next, so a stale
  # shell never pulls mismatched assets.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
