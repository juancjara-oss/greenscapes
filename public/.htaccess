DirectoryIndex index.html

# Canonical host: force non-www. Both hostnames resolve to this same docroot,
# and both returned HTTP 200 with no redirect, so every page existed at two
# crawlable URLs. The <link rel="canonical"> tags already pointed at the
# non-www version and Google had mostly consolidated on its own, but two live
# copies still split crawl budget on a low-authority domain. Make it a hard
# 301. This must stay ABOVE any other rewrite so it runs first.
# NOTE: this is a host redirect only — do NOT turn it into an SPA catch-all
# (see the ErrorDocument comment below for why that broke things before).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# This is a fully static Next.js export with trailingSlash: true, so every real
# route exists on disk as a directory containing index.html. mod_dir resolves
# those (and 301-redirects the missing trailing slash), so NO SPA catch-all
# rewrite is needed. The old "RewriteRule ^ index.html [L]" served homepage
# content with HTTP 200 for every nonexistent URL, which made typo'd and stale
# links look to Google like duplicate copies of the homepage. Serve Next's real
# 404 page with a real 404 status instead.
ErrorDocument 404 /404.html

# Cache static assets for 1 year
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg       "access plus 1 year"
  ExpiresByType image/jpg        "access plus 1 year"
  ExpiresByType image/png        "access plus 1 year"
  ExpiresByType image/webp       "access plus 1 year"
  ExpiresByType image/gif        "access plus 1 year"
  ExpiresByType image/svg+xml    "access plus 1 year"
  ExpiresByType image/x-icon     "access plus 1 year"
  ExpiresByType video/mp4        "access plus 1 year"
  ExpiresByType font/woff2       "access plus 1 year"
  ExpiresByType font/woff        "access plus 1 year"
  ExpiresByType text/css         "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico|woff2|woff|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
